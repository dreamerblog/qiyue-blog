{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1080px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "墨色", "color": "#202521" },
        { "slug": "text", "name": "正文灰", "color": "#585d59" },
        { "slug": "primary", "name": "鼠尾草绿", "color": "#566b58" },
        { "slug": "soft", "name": "浅灰绿", "color": "#eff1ed" },
        { "slug": "background", "name": "暖白", "color": "#f7f7f5" },
        { "slug": "white", "name": "纯白", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "系统字体",
          "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "#f7f7f5",
      "text": "#585d59"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "2"
    },
    "elements": {
      "link": {
        "color": { "text": "#566b58" }
      }
    }
  }
}
